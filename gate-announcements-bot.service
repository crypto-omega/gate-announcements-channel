[Unit]
Description=Gate.io Announcements Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/data0/tsl/Dropbox/Repos/crypto-omega/gate-announcements-channel
ExecStart=/data0/tsl/base/bin/python gate_announcements_bot.py
